.env
data/mmis.db
# Pre-change DB snapshots (e.g. mmis.db.pre-T2) and any sqlite sidecar files.
# NOTE: the line above matches the literal path only, not the data/ directory,
# so snapshots need their own rule or a 52 MB file becomes committable.
data/mmis.db.*
data/images/
__pycache__/
*.pyc

# MLflow run tracking histories and tracking db
mlruns/
mlflow.db

# Large pre-trained weights, scalers and generated HMM binaries (regenerated by the pipeline)
models/*.pt
models/*.pkl

# Generated CSVs and JSON evaluation reports
results/
# Local artifact baselines (never commit)
backups/
